# PostgreSQL. Copy to .env.local and configure the actual connection privately.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lumina?schema=public"

# Define all four real selling prices in USD before enabling checkout.
PRODUCT_USD_PRICES_JSON=
# Example format only; do not treat these as real store prices:
# PRODUCT_USD_PRICES_JSON={"audifonos-pulse":"0.00","smartwatch-active":"0.00","powerbank-compact":"0.00","camara-smart-home":"0.00"}

# Enter real shipping in USD and an applicable tax rate (e.g. 0.16 for 16%).
# Set CHECKOUT_FEES_CONFIRMED=true only after reviewing the actual policy.
SHIPPING_USD=
TAX_RATE=
CHECKOUT_FEES_CONFIRMED=false

# Public Pago Móvil destination displayed to customers.
PAYMENT_MOBILE_BANK=
PAYMENT_MOBILE_PHONE=
PAYMENT_MOBILE_ID=
PAYMENT_MOBILE_OWNER=

# Generate a random 32-byte key (base64) and keep it private.
PAYMENT_DATA_ENCRYPTION_KEY=
# Generate a separate long random secret, e.g. openssl rand -hex 32.
BCV_QUOTE_SIGNING_KEY=
# Generate a long random token and keep it private.
ADMIN_PAYMENT_REVIEW_TOKEN=

# SMTP settings. Never commit real passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PAYMENT_REVIEW_EMAIL=
